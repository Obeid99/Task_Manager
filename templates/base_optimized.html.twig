<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Task Manager{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
            <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
            <style>
                :root {
                    --primary-color: #2C3E50;
                    --accent-color: #FF6B9D;
                    --success-color: #27AE60;
                    --warning-color: #F39C12;
                    --danger-color: #E74C3C;
                    --white: #FFFFFF;
                    --light-bg: #F8F9FA;
                    --dark-text: #2C3E50;
                    --brand-gradient: linear-gradient(135deg, #FF6B9D 0%, #F8B500 100%);
                }

                body {
                    background: var(--light-bg);
                    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                    color: var(--dark-text);
                }

                /* Sidebar - Simplified */
                .sidebar {
                    position: fixed;
                    top: 0;
                    left: 0;
                    height: 100vh;
                    width: 280px;
                    background: var(--primary-color);
                    color: var(--white);
                    z-index: 1000;
                    overflow-y: auto;
                }

                .sidebar.collapsed {
                    width: 80px;
                }

                .sidebar-header {
                    padding: 1.5rem;
                    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                }

                .logo-container {
                    display: flex;
                    align-items: center;
                    gap: 1rem;
                }

                .logo-circle {
                    width: 40px;
                    height: 40px;
                    border-radius: 50%;
                    background: var(--brand-gradient);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    color: white;
                    font-weight: bold;
                    font-size: 1.25rem;
                }

                .sidebar.collapsed .logo-info {
                    display: none;
                }

                .sidebar-toggle {
                    background: none;
                    border: none;
                    color: var(--white);
                    cursor: pointer;
                    padding: 0.5rem;
                    border-radius: 4px;
                }

                .sidebar-toggle:hover {
                    background: rgba(255, 255, 255, 0.1);
                }

                /* Navigation */
                .sidebar-nav {
                    padding: 1rem 0;
                }

                .nav-link {
                    color: rgba(255, 255, 255, 0.8);
                    padding: 0.75rem 1.5rem;
                    display: flex;
                    align-items: center;
                    text-decoration: none;
                    border: none;
                    background: none;
                }

                .nav-link:hover {
                    background: rgba(255, 255, 255, 0.1);
                    color: var(--white);
                }

                .nav-link.active {
                    background: var(--accent-color);
                    color: var(--white);
                }

                .nav-link i {
                    width: 20px;
                    margin-right: 0.75rem;
                }

                .sidebar.collapsed .nav-link span {
                    display: none;
                }

                /* Main Content */
                .main-content {
                    margin-left: 280px;
                    padding: 2rem;
                    min-height: 100vh;
                }

                .main-content.expanded {
                    margin-left: 80px;
                }

                /* Cards - Simplified */
                .card {
                    border: none;
                    border-radius: 8px;
                    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
                    background: var(--white);
                }

                .card-header {
                    background: var(--brand-gradient);
                    color: var(--white);
                    border-radius: 8px 8px 0 0;
                    border: none;
                    padding: 1rem 1.5rem;
                    font-weight: 600;
                }

                /* Buttons - Simplified */
                .btn {
                    border-radius: 6px;
                    font-weight: 500;
                    padding: 0.5rem 1rem;
                    border: none;
                }

                .btn-primary {
                    background: var(--brand-gradient);
                    color: var(--white);
                }

                .btn-success {
                    background: var(--success-color);
                    color: var(--white);
                }

                .btn-warning {
                    background: var(--warning-color);
                    color: var(--white);
                }

                .btn-danger {
                    background: var(--danger-color);
                    color: var(--white);
                }

                /* Forms - Simplified */
                .form-control, .form-select {
                    border: 1px solid #ddd;
                    border-radius: 6px;
                    padding: 0.5rem 0.75rem;
                }

                .form-control:focus, .form-select:focus {
                    border-color: var(--accent-color);
                    box-shadow: 0 0 0 0.2rem rgba(255, 107, 157, 0.25);
                }

                /* Tables - Simplified */
                .table {
                    background: var(--white);
                    border-radius: 8px;
                    overflow: hidden;
                    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
                }

                .table thead th {
                    background: var(--primary-color);
                    color: var(--white);
                    border: none;
                    font-weight: 600;
                }

                /* Mobile Responsive */
                @media (max-width: 768px) {
                    .sidebar {
                        transform: translateX(-100%);
                    }
                    
                    .sidebar.mobile-open {
                        transform: translateX(0);
                    }
                    
                    .main-content {
                        margin-left: 0;
                    }
                }

                /* User Profile Section */
                .user-profile {
                    padding: 1rem 1.5rem;
                    border-top: 1px solid rgba(255, 255, 255, 0.1);
                    margin-top: auto;
                }

                .user-avatar {
                    width: 32px;
                    height: 32px;
                    border-radius: 50%;
                    background: var(--accent-color);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    color: white;
                    font-weight: bold;
                    font-size: 0.875rem;
                }

                /* Flash Messages */
                .flash-messages {
                    margin-bottom: 1rem;
                }

                /* Footer */
                footer {
                    margin-top: 3rem;
                    padding-top: 2rem;
                    border-top: 1px solid #ddd;
                    text-align: center;
                    color: #666;
                }
            </style>
        {% endblock %}

        {% block javascripts %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
            <script>
                // Simple sidebar toggle
                function toggleSidebar() {
                    const sidebar = document.getElementById('sidebar');
                    const mainContent = document.getElementById('mainContent');
                    
                    if (sidebar && mainContent) {
                        sidebar.classList.toggle('collapsed');
                        mainContent.classList.toggle('expanded');
                    }
                }

                // Mobile sidebar toggle
                function toggleMobileSidebar() {
                    const sidebar = document.getElementById('sidebar');
                    if (sidebar) {
                        sidebar.classList.toggle('mobile-open');
                    }
                }
            </script>
        {% endblock %}
    </head>
    <body>
        <!-- Sidebar -->
        <div class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="logo-container">
                    <div class="logo-circle">
                        <span>J</span>
                    </div>
                    <div class="logo-info">
                        <div class="fw-bold">JEMS</div>
                        <small class="opacity-75">Task Manager</small>
                    </div>
                </div>
                <button class="sidebar-toggle" onclick="toggleSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
            </div>

            <nav class="sidebar-nav">
                {% if app.user %}
                    <a href="{{ path('app_task_index') }}" class="nav-link">
                        <i class="fas fa-tasks"></i>
                        <span>Tasks</span>
                    </a>
                    <a href="{{ path('app_user_profile') }}" class="nav-link">
                        <i class="fas fa-user"></i>
                        <span>My Profile</span>
                    </a>
                    {% if app.user.isAdmin %}
                        <a href="{{ path('app_admin_users') }}" class="nav-link">
                            <i class="fas fa-users"></i>
                            <span>Users</span>
                        </a>
                    {% endif %}
                {% endif %}
            </nav>

            {% if app.user %}
                <div class="user-profile">
                    <div class="d-flex align-items-center">
                        <div class="user-avatar">
                            {{ app.user.firstName ? app.user.firstName|first|upper : app.user.email|first|upper }}
                        </div>
                        <div class="ms-2 flex-grow-1">
                            <div class="fw-bold small">{{ app.user.fullName ?: app.user.email }}</div>
                            {% if app.user.isAdmin %}
                                <small class="text-warning">Admin</small>
                            {% else %}
                                <small class="opacity-75">User</small>
                            {% endif %}
                        </div>
                    </div>
                    <div class="mt-2">
                        <a href="{{ path('app_logout') }}" class="btn btn-sm btn-outline-light">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Logout</span>
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>

        <!-- Main Content -->
        <div class="main-content" id="mainContent">
            <div class="flash-messages">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>

            {% block body %}{% endblock %}

            <footer>
                <small>&copy; {{ "now"|date("Y") }} JEMS - Task Manager</small>
            </footer>
        </div>
    </body>
</html>
