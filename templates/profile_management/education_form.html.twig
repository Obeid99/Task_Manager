{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h1 class="h3 mb-0">
                        <i class="fas fa-graduation-cap me-2"></i>{{ title }}
                    </h1>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                    
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            {{ form_label(form.institution) }}
                            {{ form_widget(form.institution) }}
                            {{ form_errors(form.institution) }}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.degree) }}
                            {{ form_widget(form.degree) }}
                            {{ form_errors(form.degree) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.fieldOfStudy) }}
                            {{ form_widget(form.fieldOfStudy) }}
                            {{ form_errors(form.fieldOfStudy) }}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            {{ form_label(form.startYear) }}
                            {{ form_widget(form.startYear) }}
                            {{ form_errors(form.startYear) }}
                        </div>
                        <div class="col-md-4 mb-3">
                            {{ form_label(form.endYear) }}
                            {{ form_widget(form.endYear) }}
                            {{ form_errors(form.endYear) }}
                        </div>
                        <div class="col-md-4 mb-3">
                            {{ form_label(form.gpa) }}
                            {{ form_widget(form.gpa) }}
                            {{ form_errors(form.gpa) }}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <div class="form-check">
                                {{ form_widget(form.isCurrentlyStudying) }}
                                {{ form_label(form.isCurrentlyStudying) }}
                            </div>
                            {{ form_errors(form.isCurrentlyStudying) }}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            {{ form_label(form.description) }}
                            {{ form_widget(form.description) }}
                            {{ form_errors(form.description) }}
                        </div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <button type="submit" name="save_and_return" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Save Education
                        </button>
                        <button type="submit" name="save_and_add_another" class="btn btn-success">
                            <i class="fas fa-plus me-2"></i>Save & Add Another
                        </button>
                        <a href="{{ path('app_user_profile') }}" class="btn btn-secondary">
                            <i class="fas fa-times me-2"></i>Cancel
                        </a>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Hide end year when currently studying is checked
        document.addEventListener('DOMContentLoaded', function() {
            const currentlyStudyingCheckbox = document.querySelector('#education_form_isCurrentlyStudying');
            const endYearField = document.querySelector('#education_form_endYear').closest('.col-md-4');
            
            function toggleEndYear() {
                if (currentlyStudyingCheckbox.checked) {
                    endYearField.style.display = 'none';
                    document.querySelector('#education_form_endYear').value = '';
                } else {
                    endYearField.style.display = 'block';
                }
            }
            
            currentlyStudyingCheckbox.addEventListener('change', toggleEndYear);
            toggleEndYear(); // Initial state
        });
    </script>
{% endblock %}
