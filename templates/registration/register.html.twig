{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center py-4" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
    <div class="row w-100 justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-header text-center border-0" style="background: var(--brand-gradient); color: white;">
                    <div class="logo-circle mx-auto mb-3" style="width: 60px; height: 60px; font-size: 1.5rem;">
                        <span>J</span>
                    </div>
                    <h1 class="h4 mb-1">Join JEMS</h1>
                    <p class="mb-0 opacity-75">Create your Task Manager account</p>
                </div>
                <div class="card-body p-4">
                    {{ form_errors(registrationForm) }}

                    {{ form_start(registrationForm) }}
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    {{ form_label(registrationForm.firstName) }}
                                    {{ form_widget(registrationForm.firstName) }}
                                    <div class="form-text">
                                        {{ form_help(registrationForm.firstName) }}
                                    </div>
                                    <div class="invalid-feedback">
                                        {{ form_errors(registrationForm.firstName) }}
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    {{ form_label(registrationForm.lastName) }}
                                    {{ form_widget(registrationForm.lastName) }}
                                    <div class="form-text">
                                        {{ form_help(registrationForm.lastName) }}
                                    </div>
                                    <div class="invalid-feedback">
                                        {{ form_errors(registrationForm.lastName) }}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            {{ form_label(registrationForm.username) }}
                            {{ form_widget(registrationForm.username) }}
                            <div class="form-text">
                                {{ form_help(registrationForm.username) }}
                            </div>
                            <div class="invalid-feedback">
                                {{ form_errors(registrationForm.username) }}
                            </div>
                        </div>

                        <div class="mb-3">
                            {{ form_label(registrationForm.email) }}
                            {{ form_widget(registrationForm.email) }}
                            <div class="form-text">
                                {{ form_help(registrationForm.email) }}
                            </div>
                            <div class="invalid-feedback">
                                {{ form_errors(registrationForm.email) }}
                            </div>
                        </div>

                        <div class="mb-3">
                            {{ form_label(registrationForm.jobTitle) }}
                            {{ form_widget(registrationForm.jobTitle) }}
                            <div class="form-text">
                                {{ form_help(registrationForm.jobTitle) }}
                            </div>
                            <div class="invalid-feedback">
                                {{ form_errors(registrationForm.jobTitle) }}
                            </div>
                        </div>

                        <div class="mb-3">
                            {{ form_label(registrationForm.plainPassword.first) }}
                            {{ form_widget(registrationForm.plainPassword.first) }}
                            <div class="form-text">
                                {{ form_help(registrationForm.plainPassword.first) }}
                            </div>
                            <div class="invalid-feedback">
                                {{ form_errors(registrationForm.plainPassword.first) }}
                            </div>
                        </div>

                        <div class="mb-3">
                            {{ form_label(registrationForm.plainPassword.second) }}
                            {{ form_widget(registrationForm.plainPassword.second) }}
                            <div class="form-text">
                                {{ form_help(registrationForm.plainPassword.second) }}
                            </div>
                            <div class="invalid-feedback">
                                {{ form_errors(registrationForm.plainPassword.second) }}
                            </div>
                        </div>

                        <div class="mb-3 form-check">
                            {{ form_widget(registrationForm.agreeTerms) }}
                            {{ form_label(registrationForm.agreeTerms, 'I agree to the terms and conditions') }}
                            <div class="invalid-feedback">
                                {{ form_errors(registrationForm.agreeTerms) }}
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-user-plus me-2"></i>Create Account
                            </button>
                        </div>
                    {{ form_end(registrationForm) }}
                </div>
                <div class="card-footer text-center bg-light border-0">
                    <p class="mb-2 text-muted">Already have an account?</p>
                    <a href="{{ path('app_login') }}" class="btn btn-outline-primary">
                        <i class="fas fa-sign-in-alt me-2"></i>Sign In
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
