{% extends 'base.html.twig' %}

{% block title %}Edit Profile{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h1 class="h3 mb-0">
                        <i class="fas fa-user-edit me-2"></i>Edit Profile
                    </h1>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.firstName) }}
                            {{ form_widget(form.firstName) }}
                            {{ form_errors(form.firstName) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.lastName) }}
                            {{ form_widget(form.lastName) }}
                            {{ form_errors(form.lastName) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.jobTitle) }}
                        {{ form_widget(form.jobTitle) }}
                        {{ form_errors(form.jobTitle) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.linkedinUrl) }}
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fab fa-linkedin"></i>
                            </span>
                            {{ form_widget(form.linkedinUrl) }}
                        </div>
                        {{ form_errors(form.linkedinUrl) }}
                        <div class="form-text">{{ form_help(form.linkedinUrl) }}</div>
                    </div>

                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Note:</strong> Your username and email cannot be changed here. 
                        Contact support if you need to update these fields.
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Save Changes
                        </button>
                        <a href="{{ path('app_user_profile') }}" class="btn btn-secondary">
                            <i class="fas fa-times me-2"></i>Cancel
                        </a>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const linkedinInput = document.querySelector('#profile_edit_form_linkedinUrl');
            
            if (linkedinInput) {
                linkedinInput.addEventListener('blur', function() {
                    let url = this.value.trim();
                    
                    // Auto-format LinkedIn URL
                    if (url && !url.startsWith('http')) {
                        if (url.includes('linkedin.com')) {
                            this.value = 'https://' + url;
                        } else if (url.startsWith('linkedin.com/in/') || url.startsWith('www.linkedin.com/in/')) {
                            this.value = 'https://www.' + url.replace('www.', '');
                        }
                    }
                });
            }
        });
    </script>
{% endblock %}
