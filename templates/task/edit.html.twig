{% extends 'base.html.twig' %}

{% block title %}Edit Task - JEMS Task Manager{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-header">
            <div class="d-flex align-items-center">
                <i class="fas fa-edit me-3"></i>
                <div>
                    <h1 class="h4 mb-0">Edit Task</h1>
                    <small class="text-muted">Update task details and settings</small>
                </div>
            </div>
        </div>
        <div class="card-body">
            {{ include('task/_form.html.twig', {'button_label': 'Update Task'}) }}
        </div>
        <div class="card-footer bg-light d-flex justify-content-between">
            <a href="{{ path('app_task_index') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to Tasks
            </a>
            {{ include('task/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
