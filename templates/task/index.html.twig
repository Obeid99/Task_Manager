{% extends 'base.html.twig' %}

{% block title %}Tasks - JEMS Task Manager{% endblock %}

{% block body %}
    <div class="card mb-4">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h4 mb-0"><i class="fas fa-tasks me-2"></i>My Tasks</h1>
                <a href="{{ path('app_task_new') }}" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Create New Task
                </a>
            </div>
        </div>
        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                <tr>
                    <th><i class="fas fa-heading me-2"></i>Title</th>
                    <th><i class="fas fa-align-left me-2"></i>Description</th>
                    <th><i class="fas fa-flag me-2"></i>Status</th>
                    <th><i class="fas fa-calendar me-2"></i>Due Date</th>
                    <th><i class="fas fa-user me-2"></i>Assigned To</th>
                    {% if app.user.isAdmin %}
                        <th><i class="fas fa-user-plus me-2"></i>Created By</th>
                    {% endif %}
                    <th><i class="fas fa-cogs me-2"></i>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for task in tasks %}
                <tr>
                    <td>{{ task.title }}</td>
                    <td>{{ truncate_smart(task.description, 50) }}</td>
                    <td>
                        {% if task.finished %}
                            <span class="badge bg-success">Completed</span>
                        {% else %}
                            <span class="badge bg-warning text-dark">In Progress</span>
                        {% endif %}
                    </td>
                    <td>{{ task.dueDate ? task.dueDate|date('Y-m-d') : '' }}</td>
                    <td>
                        {% if task.assigneeName %}
                            {{ task.assigneeName }}
                        {% elseif task.assignedTo and task.assignedTo.fullName %}
                            {{ task.assignedTo.fullName }}
                        {% elseif task.assignedTo %}
                            {{ task.assignedTo.email }}
                        {% else %}
                            Unassigned
                        {% endif %}
                    </td>
                    {% if app.user.isAdmin %}
                        <td>
                            {% if task.createdBy %}
                                {% if task.createdBy.fullName %}
                                    {{ task.createdBy.fullName }}
                                {% else %}
                                    {{ task.createdBy.username }}
                                {% endif %}
                            {% else %}
                                <span class="text-muted">Deleted User</span>
                            {% endif %}
                        </td>
                    {% endif %}
                    <td>
                        <div class="btn-group" role="group">
                            <a href="{{ path('app_task_show', {'id': task.id}) }}" class="btn btn-sm btn-info">
                                <i class="fas fa-eye me-1"></i>View
                            </a>

                            {# Determine user's relationship to this task #}
                            {% set isCreator = task.createdBy and task.createdBy == app.user %}
                            {% set isAssignee = task.assignedTo and task.assignedTo == app.user %}
                            {% set isAdmin = app.user.isAdmin %}

                            {# Edit button - only for creators and admins, NOT for assignees #}
                            {% if isAdmin or (isCreator and not isAssignee) %}
                                <a href="{{ path('app_task_edit', {'id': task.id}) }}" class="btn btn-sm btn-warning">
                                    <i class="fas fa-edit me-1"></i>Edit
                                </a>
                            {% endif %}

                            {# Complete/Reopen button - for assignees, creators, and admins #}
                            {% if isAdmin or isCreator or isAssignee %}
                                <form method="post" action="{{ path('app_task_complete', {'id': task.id}) }}" style="display: inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('complete' ~ task.id) }}">
                                    {% if task.finished %}
                                        <button type="submit" class="btn btn-sm btn-secondary" title="Reopen task">
                                            <i class="fas fa-undo me-1"></i>Reopen
                                        </button>
                                    {% else %}
                                        <button type="submit" class="btn btn-sm btn-success" title="Mark as completed">
                                            <i class="fas fa-check me-1"></i>Complete
                                        </button>
                                    {% endif %}
                                </form>
                            {% endif %}

                            {# Delete button - only for admins and creators, NOT for assignees #}
                            {% if isAdmin or (isCreator and not isAssignee) %}
                                <form method="post" action="{{ path('app_task_delete', {'id': task.id}) }}" style="display: inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ task.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this task?')">
                                        <i class="fas fa-trash me-1"></i>Delete
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="{{ app.user.isAdmin ? '7' : '6' }}" class="text-center">No tasks found. <a href="{{ path('app_task_new') }}">Create your first task</a>.</td>
                </tr>
            {% endfor %}
                </tbody>
            </table>
        </div>
        </div>
    </div>
{% endblock %}
