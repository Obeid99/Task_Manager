{% extends 'base.html.twig' %}

{% block title %}Create New Task - JEMS Task Manager{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-header">
            <div class="d-flex align-items-center">
                <i class="fas fa-plus-circle me-3"></i>
                <div>
                    <h1 class="h4 mb-0">Create New Task</h1>
                    <small class="text-muted">Add a new task to your workflow</small>
                </div>
            </div>
        </div>
        <div class="card-body">
            {{ include('task/_form.html.twig') }}
        </div>
        <div class="card-footer bg-light">
            <a href="{{ path('app_task_index') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to Tasks
            </a>
        </div>
    </div>
{% endblock %}
