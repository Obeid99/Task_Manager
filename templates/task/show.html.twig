{% extends 'base.html.twig' %}

{% block title %}{{ task.title }} - JEMS Task Manager{% endblock %}

{% block body %}
    <div class="card mb-4">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <i class="fas fa-tasks me-3"></i>
                    <div>
                        <h1 class="h4 mb-0">{{ task.title }}</h1>
                        <small class="text-muted">Task Details</small>
                    </div>
                </div>
                <div class="badge {% if task.finished %}bg-success{% else %}bg-warning text-dark{% endif %} fs-6">
                    <i class="fas {% if task.finished %}fa-check-circle{% else %}fa-clock{% endif %} me-1"></i>
                    {{ task.finished ? 'Completed' : 'In Progress' }}
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-8">
                    <h5>Description</h5>
                    <p class="card-text">{{ task.description }}</p>
                </div>
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Details</h5>
                        </div>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between">
                                <span>Due Date:</span>
                                <strong>{{ task.dueDate ? task.dueDate|date('Y-m-d') : 'Not set' }}</strong>
                            </li>
                            <li class="list-group-item d-flex justify-content-between">
                                <span>Assigned To:</span>
                                <strong>
                                    {% if task.assigneeName %}
                                        {{ task.assigneeName }}
                                        {% if task.assigneeEmail %}
                                            <br><small class="text-muted">{{ task.assigneeEmail }}</small>
                                        {% endif %}
                                    {% elseif task.assignedTo and task.assignedTo.fullName %}
                                        {{ task.assignedTo.fullName }}
                                        {% if task.assignedTo.jobTitle %}
                                            <br><small class="text-muted">{{ task.assignedTo.jobTitle }}</small>
                                        {% endif %}
                                        <br><small class="text-muted">{{ task.assignedTo.email }}</small>
                                    {% elseif task.assignedTo %}
                                        {{ task.assignedTo.email }}
                                    {% else %}
                                        Not assigned
                                    {% endif %}
                                </strong>
                            </li>
                            <li class="list-group-item d-flex justify-content-between">
                                <span>Created:</span>
                                <strong>{{ task.createdAt ? task.createdAt|date('Y-m-d') : '' }}</strong>
                            </li>
                            {% if task.updatedAt %}
                            <li class="list-group-item d-flex justify-content-between">
                                <span>Last Updated:</span>
                                <strong>{{ task.updatedAt|date('Y-m-d H:i') }}</strong>
                            </li>
                            {% endif %}
                        </ul>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a href="{{ path('app_task_index') }}" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Back to Tasks
                </a>

                {# Determine user's relationship to this task #}
                {% set isCreator = task.createdBy and task.createdBy == app.user %}
                {% set isAssignee = task.assignedTo and task.assignedTo == app.user %}
                {% set isAdmin = app.user.isAdmin %}

                {# Complete/Reopen button - for assignees, creators, and admins #}
                {% if isAdmin or isCreator or isAssignee %}
                    <form method="post" action="{{ path('app_task_complete', {'id': task.id}) }}" style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('complete' ~ task.id) }}">
                        {% if task.finished %}
                            <button type="submit" class="btn btn-success" title="Reopen task">
                                <i class="fas fa-undo me-1"></i>Reopen
                            </button>
                        {% else %}
                            <button type="submit" class="btn btn-success" title="Mark as completed">
                                <i class="fas fa-check me-1"></i>Complete
                            </button>
                        {% endif %}
                    </form>
                {% endif %}

                {# Edit button - only for creators and admins, NOT for assignees #}
                {% if isAdmin or (isCreator and not isAssignee) %}
                    <a href="{{ path('app_task_edit', {'id': task.id}) }}" class="btn btn-warning">Edit</a>
                {% endif %}

                {# Delete button - only for admins and creators, NOT for assignees #}
                {% if isAdmin or (isCreator and not isAssignee) %}
                    {{ include('task/_delete_form.html.twig') }}
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
